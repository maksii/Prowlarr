# syntax=docker/dockerfile:1
#
# Toloka-enhanced Prowlarr — full-backend overlay image.
#
# Prowlarr's official build (and therefore the LinuxServer image) is a SELF-CONTAINED
# .NET publish — the image installs NO shared runtime, it runs entirely off the
# bundled payload in /app/prowlarr/bin. That makes a single-DLL swap impossible: the
# app's .deps.json describes the whole original assembly closure, so dropping in one
# rebuilt Prowlarr.Core.dll breaks assembly resolution at startup.
#
# Instead we rebuild the ENTIRE managed backend from this branch — exactly the way
# upstream's build.sh does (self-contained publish of Prowlarr.sln for the image's
# RID) — and overlay that coherent app folder onto the image's bin. The React
# frontend is untouched, so no yarn build is needed: we reuse the image's UI/ folder.
#
# Build (context = repo root):
#   docker build -f docker/Dockerfile.toloka -t prowlarr-toloka .
#
# Pin PROWLARR_VERSION to the upstream build number baked into the base image
# (10.0.0.34982 here) so the rebuilt backend reports the same version as the bundled
# UI. Bump BASE_TAG + PROWLARR_VERSION together when you rebase.
ARG BASE_TAG=nightly-2.5.0.5422-ls3
ARG PROWLARR_VERSION=10.0.0.34982

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
ARG PROWLARR_VERSION
WORKDIR /src
COPY . .
# Pin the wildcard assembly version (upstream uses 10.0.0.* → a per-build number).
RUN sed -i "s|<AssemblyVersion>[0-9.*]\+</AssemblyVersion>|<AssemblyVersion>${PROWLARR_VERSION}</AssemblyVersion>|g" src/Directory.Build.props
# Self-contained backend publish for the image's RID (musl x64), mirroring build.sh.
# Output lands in _output/net8.0/linux-musl-x64/publish — a complete app folder
# (all DLLs incl. the runtime, deps.json, runtimeconfig, apphost). No frontend.
RUN dotnet msbuild -restore src/Prowlarr.sln \
        -p:Configuration=Release \
        -p:Platform=Posix \
        -p:SelfContained=true \
        -p:RuntimeIdentifiers=linux-musl-x64 \
        -p:RunAnalyzers=false \
        -p:TreatWarningsAsErrors=false \
        -t:PublishAllRids

FROM lscr.io/linuxserver/prowlarr:${BASE_TAG}
LABEL org.opencontainers.image.title="Prowlarr (Toloka-enhanced)" \
      org.opencontainers.image.description="LinuxServer Prowlarr with the enhanced Toloka.to indexer" \
      org.opencontainers.image.source="https://github.com/maksii/Prowlarr"
# Overlay the coherent backend; the image's UI/, s6 init and config are untouched
# (COPY merges, so /app/prowlarr/bin/UI from the base image is preserved).
COPY --from=build /src/_output/net8.0/linux-musl-x64/publish/ /app/prowlarr/bin/
